# Copy to .env and fill in values. Never commit .env.

# Keycloak admin (local docker-compose only)
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# OIDC client used by the BFF
OIDC_ISSUER=http://localhost:8080/realms/microfrontend
OIDC_CLIENT_ID=shell-bff
OIDC_CLIENT_SECRET=

# BFF
BFF_PORT=4000
PUBLIC_ORIGIN=http://localhost:4000
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
API_UPSTREAM_URL=http://127.0.0.1:4100
# dev: proxy shell/remotes to their dev servers; production: serve built files
SHELL_DEV_URL=http://127.0.0.1:4200

# demo-api
DEMO_API_PORT=4100
DEMO_API_AUDIENCE=demo-api

# e2e test users (local realm only)
E2E_ALICE_PASSWORD=
E2E_BOB_PASSWORD=
